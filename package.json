{
  "name": "multidle",
  "productName": "Multidle",
  "version": "0.3.2",
  "private": true,
  "description": "Várias contas de jogos idle numa janela só, com um painel de resumo por conta",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node jogos/pokeidle.js",
    "dist": "npm test && electron-builder --win nsis",
    "dist:store": "npm test && electron-builder --win appx --publish never",
    "dist:linux": "npm test && electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.gustavoabreu94.multidle",
    "files": [
      "main.js",
      "preload.js",
      "painel.html",
      "jogos/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "artifactName": "Multidle-${version}.${ext}"
    },
    "deb": {
      "afterInstall": "build/deb-instalar.sh",
      "afterRemove": "build/deb-remover.sh"
    },
    "publish": {
      "provider": "github",
      "owner": "Gustavoabreu94",
      "repo": "multidle"
    },
    "nsis": {
      "artifactName": "Multidle-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "applicationId": "Multidle",
      "displayName": "Multidle",
      "identityName": "Multidle.Teste",
      "publisher": "CN=Multidle-Teste",
      "publisherDisplayName": "Gustavoabreu94",
      "artifactName": "Multidle-Store-${version}.${ext}",
      "languages": [
        "pt-BR"
      ]
    }
  },
  "allowScripts": {
    "electron": true
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "homepage": "https://gustavoabreu94.github.io/multidle/",
  "author": {
    "name": "Gustavoabreu94",
    "email": "gustavoabreu94@users.noreply.github.com"
  }
}
